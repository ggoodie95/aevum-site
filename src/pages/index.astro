---
const products = [
  {
    name: "Calyx.",
    type: "AI support layer",
    shape: "square",
    text:
      "When your chatbot stalls, Calyx steps in. It detects failure points, takes over weak conversations, and keeps leads moving.",
    link: "View Calyx",
  },
  {
    name: "SiteForge.",
    type: "Managed websites",
    shape: "circle",
    text:
      "Fast, managed websites for Danish businesses. Strategy, build, launch, and upkeep — handled as one system.",
    link: "View SiteForge",
  },
  {
    name: "AEVUM Care.",
    type: "Mac care suite",
    shape: "pill",
    text:
      "The friendly umbrella for Mac care. Scan, cleanup, optimize, monitor, and access Shield protection without turning system safety into black-box scareware.",
    link: "View Care",
  },
  {
    name: "AEVUM Shield.",
    type: "Mac lockdown utility",
    shape: "shield",
    text:
      "SSA — Silent Shield Agent. Lock down sketchy Wi‑Fi, get notified when microphone or webcam is in use, scan local exposure, verify firewall state, and see what is open before you act.",
    link: "View Shield",
  },
  {
    name: "AEVUM Monitor.",
    type: "Mac health view",
    shape: "ring",
    text:
      "The system-stats companion for AEVUM Care. Machine health, resource usage, uptime, and status signals — more iStat Menus than fake cleaner app.",
    link: "View Monitor",
  },
  {
    name: "AevumOS.",
    type: "Company command layer",
    shape: "triangle",
    text:
      "The internal operating system behind AevumEU. Ideas, builds, launches, operations, marketing, and growth — wired into one command layer.",
    link: "View system",
  },
];

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const brandAssetSrc = (path: string) => `${basePath}assets/brand/${path}`;
const siteIconSrc = brandAssetSrc("favicon/aevumeu-site-icon-blue.png");
const navbarLogoSrc = brandAssetSrc("logos/aevumeu-logo-navbar-white.png");
const heroBrandingSrc = brandAssetSrc("hero/aevumeu-hero-branding.webp");
const bgGlowSrc = brandAssetSrc("backgrounds/aevumeu-bg-glow.webp");
const bgCircuitSrc = brandAssetSrc("backgrounds/aevumeu-bg-circuit.webp");
const signatureSrc = `${basePath}brand/signature.png`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>AevumEU — Software for a smarter age.</title>
    <link rel="icon" type="image/png" sizes="512x512" href={siteIconSrc} />
    <link rel="apple-touch-icon" href={siteIconSrc} />
    <meta name="theme-color" content="#020711" />
    <meta
      name="description"
      content="AevumEU builds products, Mac care tools, and the internal operating system behind them."
    />
    <meta name="robots" content="noindex, nofollow, noarchive" />
  </head>

  <body>
    <div class="cursor-mist" aria-hidden="true"></div>
    <div class="ambient-mist" aria-hidden="true"></div>

    <main
      class="site-shell"
      style={`--brand-bg-glow: url(${bgGlowSrc}); --brand-bg-circuit: url(${bgCircuitSrc});`}
    >
      <header class="nav">
        <a class="brand" href="#top" aria-label="AevumEU home">
          <img
            src={navbarLogoSrc}
            alt="AevumEU"
            width="208"
            height="250"
            decoding="async"
          />
        </a>

        <nav aria-label="Primary navigation">
          <a href="#products">Products</a>
          <a href="#system">AevumOS</a>
          <a href="#philosophy">Philosophy</a>
        </nav>

        <a class="contact" href="mailto:aevum-eu@proton.me">Contact</a>
      </header>

      <section id="top" class="hero reveal-zone is-visible">
        <div class="hero-branding" aria-hidden="true">
          <img
            src={heroBrandingSrc}
            alt=""
            width="1032"
            height="856"
            decoding="async"
          />
        </div>

        <div class="hero-copy">
          <h1>AevumEU</h1>
          <p class="eyebrow">A software company.</p>
          <p class="lead">Aevum Nortum.</p>
          <p class="sublead">Software for a smarter age.</p>
          <a href="#products" class="button">View products</a>
        </div>
      </section>

      <div class="mist-divider" aria-hidden="true"></div>

      <section class="intro reveal-zone">
        <h2>AevumEU builds products for real machines, real workflows, and real operators.</h2>
        <p>From Calyx to AEVUM Care, Shield, and Monitor — every product is built to be inspectable, useful, and shipped.</p>
      </section>

      <section id="products" class="products" aria-label="AevumEU product showcase">
        {products.map((product, index) => (
          <article class="product-card reveal-zone" style={`--delay: ${index * 70}ms`}>
            <div class={`shape ${product.shape}`} aria-hidden="true"></div>
            <p class="product-type">{product.type}</p>
            <h3>{product.name}</h3>
            <p>{product.text}</p>
            <a href={product.name === "AevumOS." ? "#system" : "#products"}>{product.link}</a>
          </article>
        ))}
      </section>

      <section class="security-note reveal-zone">
        <div>
          <p class="eyebrow">AEVUM Security</p>
          <h2>SSA is the engine. Shield is the name.</h2>
          <p>
            Silent Shield Agent is the native macOS security utility underneath AEVUM Shield:
            Public Shield, Exposure Scan, Panic Airgap, Verify, logs, and local exposure checks.
            The serious parts need proper Apple Developer signing, hardened runtime, notarization,
            and privileged helper work before release.
          </p>
        </div>
      </section>

      <div class="mist-divider" aria-hidden="true"></div>

      <section id="system" class="system reveal-zone">
        <div>
          <p class="eyebrow">AevumOS</p>
          <h2>The internal system behind AevumEU.</h2>
          <p>
            AevumOS is the internal command layer that turns ideas into products, products into launches,
            and launches into operations that can be repeated, measured, and improved.
            It is the machine behind AevumEU, not the customer-facing Mac app.
          </p>
          <span>Internal system · Product engine · Not public yet</span>
        </div>
      </section>

      <section id="philosophy" class="philosophy reveal-zone">
        <p class="eyebrow">Aevum Philosophy</p>
        <h2>AevumEU is not an agency.</h2>
        <p>Build, don’t pitch.<br />Inspect, don’t scare.<br />Lock down, don’t pretend.<br />Ship, don’t stall.<br />Systems, not pages.</p>

        <div class="founder-signature" aria-label="AEU signature mark">
          <img src={signatureSrc} alt="AEU signature" />
        </div>
      </section>

      <section class="cta reveal-zone">
        <h2>If you need something that works.</h2>
        <p>Talk to us.</p>
        <a href="mailto:aevum-eu@proton.me" class="button">Email AevumEU</a>
      </section>
    </main>

    <script>
      const mist = document.querySelector(".cursor-mist");
      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight / 2;
      let mistX = mouseX;
      let mistY = mouseY;

      const canMoveMist = window.matchMedia("(pointer: fine)").matches;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (mist && canMoveMist && !reducedMotion) {
        window.addEventListener("pointermove", (event) => {
          mouseX = event.clientX;
          mouseY = event.clientY;
          mist.classList.add("is-active");
        });

        const animateMist = () => {
          mistX += (mouseX - mistX) * 0.09;
          mistY += (mouseY - mistY) * 0.09;
          mist.style.setProperty("--x", `${mistX}px`);
          mist.style.setProperty("--y", `${mistY}px`);
          requestAnimationFrame(animateMist);
        };

        animateMist();
      }

      const revealItems = document.querySelectorAll(".reveal-zone");

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
            } else {
              entry.target.classList.remove("is-visible");
            }
          });
        },
        {
          threshold: 0.16,
          rootMargin: "-4% 0px -6% 0px",
        }
      );

      revealItems.forEach((item) => revealObserver.observe(item));
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #020711;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #020711;
    color: #f7fbff;
    overflow-x: hidden;
    text-rendering: geometricPrecision;
    -webkit-font-smoothing: antialiased;
  }

  .cursor-mist {
    --x: 50vw;
    --y: 50vh;
    position: fixed;
    z-index: 2;
    left: 0;
    top: 0;
    width: 420px;
    height: 420px;
    transform: translate3d(calc(var(--x) - 50%), calc(var(--y) - 50%), 0);
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: screen;
    background:
      radial-gradient(circle at 45% 45%, rgba(25, 136, 255, 0.2), transparent 38%),
      radial-gradient(circle at 58% 56%, rgba(136, 229, 255, 0.12), transparent 50%);
    filter: blur(36px);
    transition: opacity 0.45s ease;
  }

  .cursor-mist.is-active {
    opacity: 0.7;
  }

  .ambient-mist {
    position: fixed;
    inset: auto -15vw 0 auto;
    z-index: 1;
    width: 44vw;
    height: 44vw;
    pointer-events: none;
    background: radial-gradient(circle, rgba(0, 116, 255, 0.18), transparent 62%);
    filter: blur(44px);
    opacity: 0.56;
    animation: ambientDrift 18s ease-in-out infinite alternate;
  }

  .site-shell {
    position: relative;
    z-index: 3;
    isolation: isolate;
    min-height: 100vh;
    padding: 22px;
    overflow: hidden;
    background:
      radial-gradient(circle at 18% 14%, rgba(0, 118, 255, 0.2), transparent 26rem),
      radial-gradient(circle at 82% 4%, rgba(102, 194, 255, 0.12), transparent 24rem),
      linear-gradient(180deg, #020711 0%, #04101d 42%, #020711 100%);
  }

  .site-shell::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background-image: radial-gradient(circle, rgba(204, 230, 255, 0.2) 0 1px, transparent 1.5px);
    background-size: 56px 56px;
    opacity: 0.12;
    animation: particleDrift 32s linear infinite;
  }

  .site-shell::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -3;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.035), transparent),
      radial-gradient(circle at 50% 110%, rgba(0, 61, 145, 0.42), transparent 36rem);
    opacity: 0.72;
  }

  .nav {
    position: sticky;
    top: 22px;
    z-index: 20;
    max-width: 1120px;
    margin: 0 auto;
    padding: 12px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid rgba(139, 190, 255, 0.18);
    border-radius: 999px;
    background: rgba(2, 8, 18, 0.78);
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 70px rgba(0, 0, 0, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .brand,
  .contact,
  nav a,
  .button,
  .product-card a {
    color: #f7fbff;
    text-decoration: none;
  }

  .brand {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 74px;
    position: relative;
  }

  .brand::before {
    content: "";
    position: absolute;
    inset: -12px -18px;
    z-index: -1;
    border-radius: 999px;
    background: radial-gradient(ellipse at center, rgba(0, 118, 255, 0.18), transparent 68%);
    filter: blur(12px);
    opacity: 0.58;
    animation: logoBreath 8s ease-in-out infinite;
  }

  .brand img {
    display: block;
    width: auto;
    height: 58px;
    filter: drop-shadow(0 0 11px rgba(25, 136, 255, 0.34));
    animation: navLogoBreath 8s ease-in-out infinite;
  }

  nav {
    display: flex;
    gap: 24px;
    font-size: 14px;
  }

  nav a {
    color: #aab6c8;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: #ffffff;
  }

  .contact {
    padding: 9px 14px;
    border-radius: 999px;
    background: rgba(0, 104, 255, 0.16);
    border: 1px solid rgba(78, 158, 255, 0.42);
    color: #f7fbff;
    font-size: 14px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .contact:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 0 4px rgba(48, 139, 255, 0.18);
  }

  .hero {
    position: relative;
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(360px, 1fr) minmax(280px, 0.74fr);
    gap: 70px;
    align-items: center;
    padding: 50px 0 96px;
  }

  .hero::after {
    content: "";
    position: absolute;
    left: 3%;
    top: 12%;
    z-index: -1;
    width: min(540px, 58vw);
    aspect-ratio: 1.55;
    border-radius: 50%;
    background:
      radial-gradient(circle at 44% 48%, rgba(65, 178, 255, 0.16), transparent 34%),
      radial-gradient(circle at 60% 58%, rgba(0, 86, 255, 0.12), transparent 54%);
    filter: blur(34px);
    opacity: 0.75;
    animation: heroAura 12s ease-in-out infinite;
    pointer-events: none;
  }

  .hero::before {
    content: "";
    position: absolute;
    left: -7%;
    bottom: 3%;
    z-index: -1;
    width: min(720px, 76vw);
    aspect-ratio: 2.24;
    background-image: var(--brand-bg-glow);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    filter: blur(14px) saturate(1.18);
    opacity: 0.2;
    animation: blueBreath 10s ease-in-out infinite;
  }

  .hero-branding {
    position: relative;
    isolation: isolate;
    width: min(100%, 570px);
    justify-self: center;
    overflow: visible;
    perspective: 900px;
  }

  .hero-branding::before {
    content: "";
    position: absolute;
    inset: 5% -1% 6%;
    z-index: -1;
    border-radius: 42%;
    background:
      radial-gradient(circle at 50% 38%, rgba(0, 118, 255, 0.42), transparent 34%),
      radial-gradient(ellipse at 52% 72%, rgba(0, 168, 255, 0.24), transparent 56%);
    filter: blur(38px);
    animation: blueBreath 8s ease-in-out infinite;
  }

  .hero-branding::after {
    content: "";
    position: absolute;
    inset: -8% -12%;
    z-index: 2;
    background: linear-gradient(110deg, transparent 39%, rgba(255, 255, 255, 0.28), transparent 51%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 45%, transparent 72%);
    mask-image: radial-gradient(ellipse at center, #000 45%, transparent 72%);
    mix-blend-mode: screen;
    opacity: 0;
    transform: translateX(-130%);
    animation: lightSweep 8s ease-in-out infinite;
    pointer-events: none;
  }

  .hero-branding img {
    display: block;
    width: 100%;
    height: auto;
    position: relative;
    z-index: 1;
    mix-blend-mode: screen;
    filter:
      drop-shadow(0 0 14px rgba(42, 168, 255, 0.3))
      drop-shadow(0 0 34px rgba(0, 78, 255, 0.22));
    animation: heroBreath 9s ease-in-out infinite;
  }

  .hero-copy {
    max-width: 430px;
  }

  .hero h1 {
    margin: 0;
    font-size: 64px;
    line-height: 0.96;
    letter-spacing: 0;
    text-shadow: 0 0 40px rgba(78, 170, 255, 0.1);
  }

  .lead {
    margin: 26px 0 0;
    font-size: 30px;
    line-height: 1.12;
    color: #f7fbff;
  }

  .sublead {
    margin: 8px 0 0;
    font-size: 18px;
    line-height: 1.5;
    color: #aab6c8;
  }

  .hero p,
  .intro p,
  .system p,
  .security-note p,
  .philosophy p,
  .cta p,
  .product-card p {
    color: #aab6c8;
  }

  .eyebrow,
  .product-type {
    color: #74b8ff !important;
    font-size: 12px;
    letter-spacing: 0;
    text-transform: uppercase;
    font-weight: 700;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 24px;
    padding: 13px 20px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(0, 118, 255, 0.92), rgba(0, 74, 190, 0.92));
    border: 1px solid rgba(145, 199, 255, 0.38);
    color: #ffffff;
    box-shadow: 0 14px 42px rgba(0, 92, 255, 0.22);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
    border-color: rgba(193, 223, 255, 0.68);
    box-shadow: 0 0 0 4px rgba(48, 139, 255, 0.18), 0 18px 52px rgba(0, 92, 255, 0.26);
  }

  .mist-divider {
    position: relative;
    max-width: 960px;
    height: 1px;
    margin: 16px auto;
    background: linear-gradient(90deg, transparent, rgba(67, 151, 255, 0.42), transparent);
  }

  .mist-divider::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(70vw, 760px);
    height: 150px;
    transform: translate(-50%, -50%);
    background:
      radial-gradient(ellipse at center, rgba(0, 118, 255, 0.2), transparent 64%),
      radial-gradient(ellipse at 35% 50%, rgba(136, 229, 255, 0.1), transparent 58%);
    filter: blur(28px);
    opacity: 0.78;
    pointer-events: none;
  }

  .intro,
  .system,
  .security-note,
  .philosophy,
  .cta {
    max-width: 920px;
    margin: 0 auto;
    padding: 118px 0;
  }

  .intro {
    text-align: center;
  }

  .intro h2,
  .system h2,
  .security-note h2,
  .philosophy h2,
  .cta h2 {
    color: #f7fbff;
  }

  .founder-signature {
    width: min(210px, 48vw);
    margin: 46px 4vw 0 auto;
    position: relative;
    opacity: 0.96;
    padding: 18px 20px;
    border: 1px solid rgba(139, 190, 255, 0.12);
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(9, 24, 42, 0.52), rgba(2, 8, 18, 0.24));
    box-shadow: 0 22px 70px rgba(0, 0, 0, 0.24);
  }

  .founder-signature::before {
    content: "";
    position: absolute;
    inset: -18px;
    z-index: -1;
    border-radius: 18px;
    background: radial-gradient(ellipse at center, rgba(0, 118, 255, 0.18), transparent 72%);
    filter: blur(18px);
    animation: logoBreath 10s ease-in-out infinite;
  }

  .founder-signature::after {
    content: "";
    position: absolute;
    right: 18px;
    bottom: 12px;
    width: 64px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(116, 184, 255, 0.72), transparent);
  }

  .founder-signature img {
    display: block;
    width: 100%;
    height: auto;
    transform: rotate(-1deg);
    filter:
      invert(1)
      brightness(1.55)
      drop-shadow(0 0 10px rgba(116, 184, 255, 0.28))
      drop-shadow(0 0 24px rgba(0, 118, 255, 0.18));
  }


  h2 {
    margin: 0;
    font-size: 58px;
    line-height: 0.94;
    letter-spacing: 0;
  }

  .products {
    position: relative;
    max-width: 1120px;
    margin: 0 auto;
    padding: 112px 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .products::before,
  .security-note::before,
  .system::before {
    content: "";
    position: absolute;
    inset: 36px -7% 24px;
    z-index: -1;
    background-image: var(--brand-bg-circuit);
    background-position: center;
    background-repeat: repeat-x;
    background-size: 680px auto;
    opacity: 0.055;
    filter: saturate(1.15) blur(0.4px);
    mix-blend-mode: screen;
    -webkit-mask-image:
      radial-gradient(ellipse at center, #000 0 32%, transparent 76%),
      linear-gradient(90deg, transparent, #000 18% 82%, transparent);
    mask-image:
      radial-gradient(ellipse at center, #000 0 32%, transparent 76%),
      linear-gradient(90deg, transparent, #000 18% 82%, transparent);
    pointer-events: none;
  }

  .product-card {
    position: relative;
    overflow: hidden;
    min-height: 390px;
    padding: 26px;
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(11, 27, 47, 0.88), rgba(5, 15, 28, 0.94)),
      radial-gradient(circle at 24% 12%, rgba(0, 118, 255, 0.16), transparent 16rem);
    border: 1px solid rgba(139, 190, 255, 0.16);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, opacity 0.5s ease, filter 0.5s ease;
  }

  .product-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 40%, rgba(255, 255, 255, 0.06), transparent 58%);
    opacity: 0;
    transform: translateX(-80%);
    transition: opacity 0.25s ease, transform 0.55s ease;
    pointer-events: none;
  }

  .product-card:hover {
    transform: translateY(-6px);
    border-color: rgba(91, 170, 255, 0.55);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.3), 0 0 42px rgba(0, 118, 255, 0.18);
  }

  .product-card:hover::before {
    opacity: 1;
    transform: translateX(70%);
  }

  .product-card h3 {
    font-size: 32px;
    line-height: 0.95;
    letter-spacing: 0;
    margin: 20px 0 10px;
    color: #ffffff;
  }

  .product-card p {
    margin: 0 0 18px;
    font-size: 16px;
    line-height: 1.2;
  }

  .product-card a {
    font-weight: 650;
    color: #9bcaff;
  }

  .product-type {
    margin-top: 30px !important;
    margin-bottom: 0 !important;
    color: #7abaff !important;
  }

  .shape {
    width: 88px;
    height: 88px;
    margin-bottom: auto;
    background: linear-gradient(135deg, #f7fbff, #8ac7ff 52%, #005eff);
    box-shadow: 0 0 34px rgba(0, 118, 255, 0.24);
    animation: float 5.4s ease-in-out infinite;
  }

  .circle,
  .ring {
    border-radius: 999px;
  }

  .ring {
    background: transparent;
    border: 18px solid #dff0ff;
  }

  .pill {
    width: 120px;
    border-radius: 999px;
